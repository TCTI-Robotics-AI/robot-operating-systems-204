<?xml version="1.0"?>
<robot name="course_mobile">
  <material name="blue"><color rgba="0.1 0.35 0.85 1"/></material>
  <material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
  <link name="base_link">
    <inertial><mass value="3"/><inertia ixx="0.0137" ixy="0" ixz="0" iyy="0.0241" iyz="0" izz="0.0346"/></inertial>
    <visual><geometry><box size="0.30 0.22 0.08"/></geometry><material name="blue"/></visual>
    <collision><geometry><box size="0.30 0.22 0.08"/></geometry></collision>
  </link>
  <link name="left_wheel">
    <inertial><mass value="0.15"/><inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00027" iyz="0" izz="0.00015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.06" length="0.025"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.06" length="0.025"/></geometry></collision>
  </link>
  <link name="right_wheel">
    <inertial><mass value="0.15"/><inertia ixx="0.00015" ixy="0" ixz="0" iyy="0.00027" iyz="0" izz="0.00015"/></inertial>
    <visual><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.06" length="0.025"/></geometry><material name="black"/></visual>
    <collision><origin rpy="1.57079632679 0 0"/><geometry><cylinder radius="0.06" length="0.025"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.125 -0.06"/><axis xyz="0 1 0"/><dynamics damping="0.02" friction="0"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.125 -0.06"/><axis xyz="0 1 0"/><dynamics damping="0.02" friction="0"/></joint>
  <link name="front_caster">
    <inertial><mass value="0.02"/><inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/></inertial>
    <visual><geometry><sphere radius="0.025"/></geometry></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
  </link>
  <joint name="front_caster_joint" type="fixed"><parent link="base_link"/><child link="front_caster"/><origin xyz="0.11 0 -0.095"/></joint>
  <link name="rear_caster">
    <inertial><mass value="0.02"/><inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/></inertial>
    <visual><geometry><sphere radius="0.025"/></geometry></visual>
    <collision><geometry><sphere radius="0.025"/></geometry></collision>
  </link>
  <joint name="rear_caster_joint" type="fixed"><parent link="base_link"/><child link="rear_caster"/><origin xyz="-0.11 0 -0.095"/></joint>
  <gazebo reference="base_link"><material>Gazebo/Blue</material></gazebo>
  <gazebo reference="left_wheel"><mu1>1</mu1><mu2>1</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="right_wheel"><mu1>1</mu1><mu2>1</mu2><material>Gazebo/Black</material></gazebo>
  <gazebo reference="front_caster"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo reference="rear_caster"><mu1>0.01</mu1><mu2>0.01</mu2></gazebo>
  <gazebo>
    <plugin name="differential_drive" filename="libgazebo_ros_diff_drive.so">
      <robotNamespace>/</robotNamespace><updateRate>50</updateRate>
      <leftJoint>left_wheel_joint</leftJoint><rightJoint>right_wheel_joint</rightJoint>
      <wheelSeparation>0.25</wheelSeparation><wheelDiameter>0.12</wheelDiameter>
      <wheelAcceleration>1.0</wheelAcceleration><wheelTorque>3</wheelTorque>
      <commandTopic>cmd_vel</commandTopic><odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame><robotBaseFrame>base_link</robotBaseFrame>
      <odometrySource>world</odometrySource><publishOdomTF>true</publishOdomTF>
      <publishWheelTF>false</publishWheelTF><publishWheelJointState>true</publishWheelJointState>
      <legacyMode>false</legacyMode>
    </plugin>
  </gazebo>
</robot>
