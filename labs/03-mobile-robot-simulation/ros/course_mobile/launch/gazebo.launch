<launch>
  <arg name="gui" default="true"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find course_mobile)/worlds/classroom.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <param name="robot_description" textfile="$(find course_mobile)/urdf/mobile.urdf"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_mobile" args="-urdf -param robot_description -model course_mobile -z 0.12" output="screen"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>
</launch>
