<launch>
  <arg name="gui" default="true"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find course_mobile)/worlds/classroom.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <param name="robot_description" command="$(find xacro)/xacro '$(find course_arm)/urdf/arm.urdf.xacro' gripper:=true"/>
  <rosparam command="load" file="$(find course_arm)/config/controllers.yaml" ns="arm"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_arm" args="-urdf -param robot_description -model course_arm" output="screen"/>
  <node pkg="controller_manager" type="spawner" name="controllers" ns="arm" args="joint_state_controller shoulder_controller elbow_controller wrist_controller gripper_controller" output="screen"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <remap from="joint_states" to="/arm/joint_states"/>
  </node>
</launch>
