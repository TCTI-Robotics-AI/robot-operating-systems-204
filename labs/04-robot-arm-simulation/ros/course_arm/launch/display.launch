<launch>
  <arg name="gripper" default="true"/>
  <arg name="rviz" default="true"/>
  <param name="robot_description" command="$(find xacro)/xacro '$(find course_arm)/urdf/arm.urdf.xacro' gripper:=$(arg gripper)"/>
  <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher">
    <remap from="joint_states" to="/arm/joint_states"/>
  </node>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
    <remap from="joint_states" to="/arm/joint_states"/>
  </node>
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz" args="-d $(find course_arm)/rviz/arm.rviz"/>
</launch>
