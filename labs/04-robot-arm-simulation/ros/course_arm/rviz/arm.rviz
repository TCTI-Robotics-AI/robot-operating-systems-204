Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: world
    Background Color: 40; 40; 40
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 1.2
      Pitch: 0.5
      Yaw: 0.8
